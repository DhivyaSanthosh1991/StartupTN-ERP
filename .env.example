# Copy to .env for local development (the API reads it from the repo root).
# On AWS none of this is a file: set these as environment variables on the API task,
# with secrets (JWT_SECRET, JOBS_TOKEN, the database URL) coming from Secrets Manager.

# ---- API (apps/api) ----
NODE_ENV=development
PORT=4000

# PostgreSQL. With the docker-compose.yml in this folder:
DATABASE_URL=postgres://erp:erp@localhost:5432/erp_dev
# off = plain connection (local). On Amazon RDS use verify (needs the RDS certificate bundle, which the
# API Dockerfile includes) or no-verify (encrypted, but the server's certificate is not checked).
DATABASE_SSL=off

# Signs the session cookie. At least 16 characters; use a long random value anywhere real.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12

# Google Workspace sign-in. Only accounts on this domain can sign in, and only if they already
# exist as employees. Create an OAuth "Web application" client at console.cloud.google.com and
# add your site's address under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=startuptn.in

# Development only: sign in as a demo employee without Google. Forced off when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# Documents. "local" keeps files on this machine (development only; refused in production).
# "s3" uses the bucket below, with the task's IAM role: no access keys in the environment.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=data/uploads
S3_BUCKET=
AWS_REGION=ap-south-1

# Notification emails. "log" prints them to the console; "ses" sends through Amazon SES
# (the sending address or domain must be verified in SES).
EMAIL_DRIVER=log
EMAIL_FROM=StartupTN ERP <no-reply@startuptn.in>

# The web address people use, for links inside emails.
WEB_ORIGIN=http://localhost:3000

# Proxies in front of the API: 1 for a load balancer alone, 2 when CloudFront sits in front of it.
# Makes the address in the audit log the real client's.
TRUST_PROXY_HOPS=1

# Shared secret that the scheduler sends (header x-jobs-token) to /api/jobs/*. At least 16 characters in production.
JOBS_TOKEN=change-me-too
# Secret for the small program on the biometric PC that pushes punches to /api/jobs/biometric-push.
# At least 16 characters. Leave empty to switch pushing off.
BIOMETRIC_PUSH_TOKEN=

# Head-office biometric machine (eSSL eTimeTracklite "Web API Service"). Leave BIOMETRIC_API_URL empty to
# bring punches in by file import only. When it is set, the other three are required.
# The user name and password are sent in the request body: use https or a private network.
# Put the password in Secrets Manager on AWS.
BIOMETRIC_API_URL=
BIOMETRIC_API_USER=
BIOMETRIC_API_PASSWORD=
# Comma-separated serial numbers of the machines to ask, e.g. BRM9202760325,BRM9202760326
BIOMETRIC_DEVICE_SERIALS=
# How many days back each pull (every 15 minutes) asks for. 1 to 31.
BIOMETRIC_LOOKBACK_DAYS=2

# ---- Web (apps/web) ----
# Where the web server forwards /api/* to. Read when the web app is BUILT, not when it starts.
# Not used if CloudFront sends /api/* straight to the API's load balancer.
API_ORIGIN=http://localhost:4000

# Phone app: when true, check-in, breaks, presence checks and tracking work only from the mobile app
REQUIRE_MOBILE_APP=false
MOBILE_SESSION_DAYS=60
